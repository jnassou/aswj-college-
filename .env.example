# Public browser/server connection values from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only privileged database key. Never prefix this with NEXT_PUBLIC_.
# Required by email delivery and by the protected Microsoft Forms fallback.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LEGACY FALLBACK ONLY. Not required by the native Student Portal form.
# Generate a long random value only if Power Automate is deliberately enabled.
MS_FORMS_INGEST_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Legacy fallback only. Reject deliveries that do not identify this exact Microsoft Form.
MS_FORMS_FORM_ID=YOUR_MICROSOFT_FORM_ID

# Required server-side canonical origin for signup confirmation returns and
# Student Portal links. Use the stable dev origin in dev and the custom domain
# in Production.
EMAIL_APP_BASE_URL=https://YOUR_ENVIRONMENT_DOMAIN

# Optional transactional email delivery. All values below are server-only.
# Leave disabled until the database migration, verified Resend domain, webhook,
# and scheduler are ready. Disabled or incomplete delivery never claims emails;
# a configured signed webhook still records outcomes for prior submissions.
EMAIL_DELIVERY_ENABLED=false
# Must exactly match the 20-character project ref in NEXT_PUBLIC_SUPABASE_URL.
# This prevents an email worker from consuming a different environment's queue.
EMAIL_DELIVERY_EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Required outside Production. Set this to the Production project ref so a
# dev/Preview worker refuses to run if it is accidentally connected to Production.
EMAIL_DELIVERY_PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
RESEND_API_KEY=re_CHANGE_ME
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME
CRON_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
EMAIL_FROM="ASWJ College <no-reply@YOUR_VERIFIED_DOMAIN>"
EMAIL_REPLY_TO=admin@YOUR_VERIFIED_DOMAIN

# Non-production only. In Vercel Preview or a local runtime, every message is
# forced to this administrator-controlled mailbox and marked [DEV]. Only an
# explicit VERCEL_ENV=production deployment may use real recipients.
EMAIL_DELIVERY_TEST_RECIPIENT=tester@example.com
